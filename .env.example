# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Security ──────────────────────────────────────────────
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHAR_SECRET
ADMIN_PASSWORD_HASH=                   # generated by scripts/setup.js
SESSION_SECRET=CHANGE_THIS_ALSO

# ─── Email (Gmail SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-event-email@gmail.com
SMTP_PASS=your-app-password            # Gmail App Password (not account password)
EMAIL_FROM="Summer Fest 2026 <your-event-email@gmail.com>"

# ─── Database ──────────────────────────────────────────────
DB_PATH=./summerfest.db

# ─── File Storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
TICKET_DIR=./tickets
MAX_FILE_SIZE_MB=5

# ─── Event ─────────────────────────────────────────────────
EVENT_NAME=Summer Fest 2026
EVENT_DATE=8th April 2026
EVENT_TIME=6:00 PM – 10:00 PM
EVENT_VENUE=Cricket Ground, VIT Bhopal
EVENT_DESCRIPTION=Bolly-Tech Experience · International DJ · Dance Performances
TICKET_PRICE=₹299

# ─── Rate Limiting ─────────────────────────────────────────
SCAN_RATE_LIMIT=60                     # max check-ins per minute per IP

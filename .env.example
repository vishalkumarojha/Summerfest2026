# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Security ──────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_64_CHAR_SECRET
SESSION_SECRET=CHANGE_THIS_ALSO

# ─── Database (Supabase) ───────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=eyJ...GET_FROM_SUPABASE_PROJECT_SETTINGS_API

# ─── Email (Gmail SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@domain.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM="Summer Fest 2026 <your-email@domain.com>"

# ─── File Storage ──────────────────────────────────────────────
MAX_FILE_SIZE_MB=5

# ─── Event ─────────────────────────────────────────────────
EVENT_NAME=Summer Fest 2026
EVENT_DATE=8th April 2026
EVENT_TIME=6PM - 10PM
EVENT_VENUE=Cricket Ground, VIT Bhopal
EVENT_DESCRIPTION=Bolly-Tech Experience · International DJ · Dance Performances
TICKET_PRICE=₹299

# ─── Rate Limiting ─────────────────────────────────────────
SCAN_RATE_LIMIT=60

# ─── CORS / Deployment ─────────────────────────────────────────
# Comma-separated: Vercel scanner URL + Railway backend URL
ALLOWED_ORIGIN=https://summerfest-scanner.vercel.app,https://YOUR-APP.up.railway.app
